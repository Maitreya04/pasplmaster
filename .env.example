# Supabase - required for client (Vercel, local dev)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here
VITE_PUSH_VAPID_PUBLIC_KEY=your-vapid-public-key-here

# Deploy edge function for staff activation (invite code → phone+PIN):
#   supabase functions deploy activate-user
# Requires migrations 128–133 applied on the project.

# Optional: set true only if WebSockets are blocked on your network (some offices
# block wss:// while REST still works). Supabase Free still includes Realtime.
# VITE_DISABLE_SUPABASE_REALTIME=true

# Optional: use compact queue snapshots + low-volume queue_events Realtime.
# Requires the queue_events/get_billing_queue_snapshot migration to be applied.
VITE_BILLING_QUEUE_EVENTS=true

# Optional: opt back into direct Postgres Changes on hot base tables for local
# debugging only. Production should keep this unset so Realtime uses queue_events
# plus REST polling instead of orders/order_items/work_claims subscriptions.
# VITE_ENABLE_DIRECT_TABLE_REALTIME=true

# Optional: business name at the end of customer WhatsApp / copy summary (default: Pathak Auto Sales)
# VITE_BUSINESS_DISPLAY_NAME=Pathak Auto Sales Pvt. Ltd.

# Optional: Google Gemini API key for admin OCR (order lab) and Purchase invoice PDF extraction.
# Prefer `.env.local` (gitignored) so the key is not committed.
# VITE_GEMINI_API_KEY=
